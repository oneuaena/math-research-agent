{
  "name": "math-research-agent",
  "version": "1.0.0",
  "private": true,
  "description": "A reproducible, auditable autonomous research workspace for experimental mathematics and conjecture exploration.",
  "author": "Math Research Agent Contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/lu-chuanyou/math-research-agent.git"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && npm run electron:build && electron . --dev\"",
    "build": "npm run typecheck && vite build && npm run electron:build",
    "electron:build": "tsc -p electron/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "runtime:prepare": "node scripts/prepare-python-runtime.mjs",
    "test:bundled-python": "node scripts/bundled-python-smoke.mjs",
    "test:packaged-runtime": "node scripts/packaged-runtime-smoke.mjs",
    "lint": "eslint .",
    "dist": "npm run runtime:prepare && npm run build && electron-builder --win nsis --x64",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.1",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.2.1",
    "vitest": "^4.0.15",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "studio.mathresearch.agent",
    "productName": "Math Research Agent",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "worker.py"
        ]
      },
      {
        "from": "runtime/python",
        "to": "runtime/python"
      },
      {
        "from": "LICENSE",
        "to": "licenses/LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "licenses/NOTICE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Math-Research-Agent-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
